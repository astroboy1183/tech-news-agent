{
  "name": "tech-news-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy --triggers \"*/5 * * * *\"",
    "typecheck": "react-router typegen && wrangler types && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply tech-news --local",
    "db:migrate:remote": "wrangler d1 migrations apply tech-news --remote",
    "seed:local": "tsx scripts/seed.ts --local",
    "seed:remote": "tsx scripts/seed.ts --remote",
    "opml:import": "tsx scripts/import-opml.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "isbot": "^5.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260905.1",
    "@react-router/dev": "^8.3.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0"
}
